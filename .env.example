# Supabase Configuration
# Optional: If not provided, Family Vault runs in standalone client-side Zero-Knowledge mode with persistent encrypted local state.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Keep OTP_ENABLED=false until provider, signing, database and worker are verified.
OTP_ENABLED=false
OTP_RECEIVING_DOMAIN=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Exact hostname(s) returned by Resend for raw.download_url; comma-separated, no wildcards.
OTP_RAW_EMAIL_HOSTS=
# Random secret for the scheduled worker. Never use the master password.
CRON_SECRET=
